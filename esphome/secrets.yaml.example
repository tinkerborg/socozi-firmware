# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
#
# `make esp` creates one from this file if it is missing, so a fresh clone and
# CI both compile without any manual step. The placeholders are good enough to
# build with and useless to run with — set real values before flashing.

wifi_ssid: "your-ssid"
wifi_password: "your-password"

# 32 random bytes, base64. Generate with:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

ota_password: "your-ota-password"
